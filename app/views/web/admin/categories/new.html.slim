.container
  .row
    = render "web/admin/shared/menu"
    .col-md-9
      .h2.mb-4 = t("admin.categories.new.title")
      = simple_form_for @category, url: admin_categories_path do |f|
        - if @category.errors.any?
          .alert.alert-danger.mb-4
            h5 = "#{pluralize(@category.errors.count, t("admin.categories.form.errors.one"), t("admin.categories.form.errors.few"), t("admin.categories.form.errors.many"), t("admin.categories.form.errors.other"))} #{t("admin.categories.form.errors.title")}"
            ul
              - @category.errors.full_messages.each do |msg|
                li = msg

        = f.input :name,
          label: t("admin.categories.form.name"),
          placeholder: t("admin.categories.form.name_placeholder"),
          required: true,
          wrapper_html: { class: "mb-4" },
          input_html: { rows: 5, class: "form-control" },
          error: false

        .d-grid.gap-2.d-md-flex.justify-content-md-start.mt-4.pt-3.border-top
          = f.button :submit, t("admin.categories.new.submit"),
            class: "btn btn-primary px-4"
          = link_to t("admin.categories.new.cancel"), admin_categories_path, class: "btn btn-outline-secondary me-2"
