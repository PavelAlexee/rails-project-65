= simple_form_for @bulletin do |f|
  - if @bulletin.errors.any?
    .alert.alert-danger.mb-4
      h5 = "#{pluralize(@bulletin.errors.count, t('bulletins.form.errors.one'), t('bulletins.form.errors.few'), t('bulletins.form.errors.many'), t('bulletins.form.errors.other'))} #{t('bulletins.form.errors.title')}"
      ul
        - @bulletin.errors.full_messages.each do |msg|
          li = msg

  = f.input :title,
    label: t('bulletins.form.title'),
    placeholder: t('bulletins.form.title_placeholder'),
    required: true,
    wrapper_html: { class: 'mb-4' },
    input_html: { class: 'form-control' },
    error: false

  = f.input :description,
    label: t('bulletins.form.description'),
    as: :text,
    placeholder: t('bulletins.form.description_placeholder'),
    required: true,
    wrapper_html: { class: 'mb-4' },
    input_html: { rows: 5, class: 'form-control' },
    error: false

  = f.association :category,
    label: t('bulletins.form.category'),
    collection: @categories,
    prompt: t('bulletins.form.category_prompt'),
    required: true,
    wrapper_html: { class: 'mb-4' },
    input_html: { class: 'form-select' },
    error: false

  .mb-4
    = f.label :image, t('bulletins.form.image'), class: 'form-label'
    - if @bulletin.image.attached? && @bulletin.persisted?
      .current-image.mb-3
        .d-flex.align-items-center.gap-3
          = image_tag @bulletin.image.variant(resize_to_limit: [100, 100]),
            class: 'img-thumbnail'
          .form-text.text-muted
            = t('bulletins.form.current_image')
            br
            small = t('bulletins.form.leave_blank_to_keep')

    = f.file_field :image,
      class: 'form-control',
      direct_upload: true,
      accept: 'image/jpeg,image/png'
    .form-text.text-muted.mt-1
      = t('bulletins.form.image_hint')

  .d-grid.gap-2.d-md-flex.justify-content-md-start.mt-4.pt-3.border-top
    = f.button :submit,
      (@bulletin.new_record? ? t('bulletins.form.create') : t('bulletins.form.update')),
      class: 'btn btn-primary px-4'

    = link_to t('bulletins.form.cancel'),
      (@bulletin.new_record? ? bulletins_path : profile_path),
      class: 'btn btn-outline-secondary me-2'
