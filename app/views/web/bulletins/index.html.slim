.jumbotron.gradient-primary.text-black.py-5.mb-4.rounded
  .container.text-center
    h1.display-5 Все объявления
    - if signed_in?
      = link_to 'Создать новое объявление', new_bulletin_path, class: 'btn btn-light btn-lg shadow'

.container
  - if @bulletins.empty?
    .text-center.py-5
      h3 Пока нет объявлений
  - else
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
      - @bulletins.each do |bulletin|
        .col
          .card.h-100.shadow-sm.hover-shadow
            - if bulletin.image.attached?
              .card-img-top.position-relative(style="height: 200px; overflow: hidden;")
                = image_tag bulletin.image, class: 'w-100 h-100 object-fit-cover'
            - else
              .card-img-top.bg-light.d-flex.align-items-center.justify-content-center(style="height: 200px;")
                span.text-muted Нет фото
            
            .card-body.d-flex.flex-column
              .mb-2
                span.badge.bg-primary
                  = bulletin.category&.name || 'Без категории'
              
              h5.card-title
                = link_to bulletin.title, bulletin_path(bulletin), class: 'text-decoration-none text-dark'
              
              p.card-text.text-muted.flex-grow-1
                = truncate(bulletin.description, length: 100)
              
              .d-flex.justify-content-between.align-items-center.mt-3
                small.text-muted
                  = link_to 'Просмотр', bulletin_path(bulletin), class: 'btn btn-outline-secondary text-dark btn-sm'

                small.text-muted
                  = time_ago_in_words(bulletin.created_at)
