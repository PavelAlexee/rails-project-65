nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4.border-bottom.border-secondary
  .container-fluid
    = link_to 'Главная', root_path, class: 'navbar-brand text-light fw-normal'

    - if signed_in?
      span.navbar-text.me-3.text-white-50
        small Привет, #{current_user.name}
      ul.nav.nav-pills
        li.nav-item.me-2
          = link_to 'Админка', admin_bulletins_path, class: 'btn btn-outline-secondary btn-sm'
        li.nav-item.me-2
          = button_to 'Выход', auth_logout_path, method: :delete, class: 'btn btn-outline-secondary btn-sm'
    - else
      = button_to 'sign in with Github', auth_request_path('github'), method: :post, data: { turbo: false }, class: 'btn btn-outline-light btn-sm'